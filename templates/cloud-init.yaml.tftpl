#cloud-config
write_files:
%{ for path, content in files ~}
  - path: /opt/app/${path}
    encoding: b64
    content: ${content}
    permissions: "${endswith(path, ".sh") ? "0755" : "0644"}"
%{ endfor ~}
  - path: /opt/app/.env
    permissions: "0600"
    content: |
%{ for k, v in env ~}
      ${k}=${v}
%{ endfor ~}
  - path: /etc/systemd/system/db-watchdog.service
    content: |
      [Unit]
      Description=PostgreSQL failover watchdog
      After=docker.service
      Requires=docker.service

      [Service]
      ExecStart=/opt/app/bin/db-watchdog.sh
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Oracle's Ubuntu images ship an iptables INPUT chain that rejects everything but SSH.
  # Open nginx and postgres (the NSGs still restrict who can reach them), and persist
  # the rules before Docker adds its own.
  - iptables -I INPUT -p tcp -m multiport --dports 80,5432 -j ACCEPT
  - netfilter-persistent save
  # Packages are installed here rather than with cloud-init's `packages:` because the VCN
  # resolver is often not answering yet that early in boot, and `packages:` never retries.
  - timeout 300 sh -c 'until getent hosts ports.ubuntu.com >/dev/null; do sleep 5; done'
  - for i in 1 2 3 4 5; do apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io docker-compose-v2 && break; sleep 15; done
  - systemctl enable --now docker
  - cd /opt/app && for i in 1 2 3; do docker compose up -d --build && break; sleep 15; done
  - systemctl daemon-reload
  - systemctl enable --now db-watchdog.service
